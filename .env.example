# ABA PayWay (https://developer.payway.com.kh)
# Get these from your PayWay merchant/sandbox registration email.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# CutLuy (https://cutluy.com) — Bakong KHQR payments.
# CUTLUY_API_KEY starts with ck_test_ (sandbox) or ck_live_ (real charges) —
# there is no separate sandbox base URL like PayWay, so make sure you're using
# a test key while developing.
CUTLUY_API_KEY=
# Signing secret for the /api/cutluy/webhook endpoint (from the CutLuy dashboard).
CUTLUY_WEBHOOK_SECRET=

# Resend (https://resend.com) — sends the license key email after a completed payment.
RESEND_API_KEY=

# Secret used to deterministically derive license keys (src/lib/license.ts).
# Generate with: openssl rand -hex 32
LICENSE_SECRET=
